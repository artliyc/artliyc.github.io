---
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
---

<section class="projects container screen" id="projects">
  <h2 class="h1 trim">Мои проекты</h2>
  <ul class="list">
    {
      projects.map((project) => (
        <li>
          <ProjectCard project={project} />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .projects {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  @media (min-width: 1024px) {
    .projects {
      gap: calc(50 * var(--u));
    }

    .list {
      display: grid;
      grid-template-columns: repeat(2, calc(804 * var(--u)));
      gap: calc(40 * var(--u));
    }

    .list li {
      display: flex;
    }
  }
</style>
