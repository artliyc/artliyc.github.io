---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import ProjectMeta from '../../components/ProjectMeta.astro';
import { projects, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const title = project.pageTitle ?? project.title;
---

<Base title={`${title} — Ирина, UX/UI дизайнер`} description={project.meta.about} activeNav="projects">
  <article class="project container">
    <a class="back h6 trim" href="/#projects">← Назад</a>

    <div class="top">
      <header class="heading">
        <h1 class="h1 trim">{title}</h1>
        {project.company && <p class="company h3 trim">{project.company}</p>}
      </header>

      <ProjectMeta tags={project.meta.tags} about={project.meta.about} />
    </div>

    {/* Role and results: stacked on mobile, two columns on desktop. */}
    <div class="texts">
      {
        project.sections.map((section) => (
          <section class="text-section">
            <h2 class="h4">{section.title}</h2>
            <div class="content trim">
              {section.blocks.map((block) =>
                'list' in block ? (
                  <ul class="text-list">
                    {block.list.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                ) : (
                  <div class="paragraphs text-1">
                    {block.paragraphs.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                  </div>
                ),
              )}
            </div>
          </section>
        ))
      }
    </div>

    {
      (project.gallery.length > 0 || project.link) && (
        <div class="media">
          {project.gallery.map((items) => <ProjectGallery items={items} />)}

          {
            project.link && (
              <div class:list={['project-link', { 'with-qr': project.link.qr }]}>
                <a class="h6 trim" href={project.link.href} target="_blank" rel="noopener noreferrer">
                  {project.link.label}
                </a>
                {project.link.qr && <Image src={project.link.qr} alt="QR-код" width={672} quality={92} />}
              </div>
            )
          }
        </div>
      )
    }
  </article>
</Base>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding-top: 40px;
    padding-bottom: 36px;
  }

  .heading {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .company {
    color: rgb(0 0 0 / 0.5);
  }

  .top,
  .texts,
  .media {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .text-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* Kept as a plain block so the text trim reaches the first and last lines inside. */
  .content {
    color: var(--color-gray);
  }

  .content > * + * {
    margin-top: 10px;
  }

  .content ul {
    list-style: disc;
  }

  .content li {
    margin-left: 24px;
  }

  .content li + li {
    margin-top: 7px;
  }

  .paragraphs p + p {
    margin-top: 15px;
  }

  .back {
    align-self: flex-start;
    color: var(--color-violet);
  }

  .project-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .project-link a {
    color: var(--color-violet);
    text-decoration: underline;
    text-underline-position: from-font;
  }

  .project-link.with-qr {
    width: 224px;
    max-width: 100%;
    text-align: center;
  }

  .project-link.with-qr a {
    text-decoration: none;
  }

  .project-link img {
    width: 100%;
    height: auto;
  }

  @media (min-width: 1024px) {
    /* Title lands 204px below the top, as on the other desktop screens. */
    .project {
      gap: calc(50 * var(--u));
      max-width: none;
      padding: calc(158 * var(--u)) calc(95 * var(--u)) calc(80 * var(--u));
    }

    .back {
      margin-bottom: calc(-20 * var(--u));
      font-size: calc(19 * var(--u));
    }

    .top {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: calc(50 * var(--u));
    }

    .heading {
      gap: calc(20 * var(--u));
      width: calc(1070 * var(--u));
    }

    /* Desktop/Headline 3 */
    .heading .h1 {
      font: 700 calc(110 * var(--u)) / calc(116 * var(--u)) var(--font-heading);
      letter-spacing: -0.03em;
    }

    /* Desktop/Headline 4 */
    .company {
      font: 700 calc(50 * var(--u)) / 0.9 var(--font-heading);
    }

    .texts {
      display: grid;
      grid-template-columns: calc(748 * var(--u)) calc(590 * var(--u));
      gap: calc(80 * var(--u));
    }

    .text-section {
      gap: calc(25 * var(--u));
    }

    /* Desktop/Headline 5 */
    .text-section h2 {
      font: 600 calc(38 * var(--u)) / 1 var(--font-heading);
      letter-spacing: -0.01em;
      text-box: trim-both cap alphabetic;
    }

    /* Desktop/List */
    .content {
      font-size: calc(24 * var(--u));
      line-height: 1.3;
      letter-spacing: -0.03em;
    }

    .content > * {
      font: inherit;
      letter-spacing: inherit;
    }

    .content > * + * {
      margin-top: calc(15 * var(--u));
    }

    .content li {
      margin-left: calc(36 * var(--u));
    }

    .content li + li {
      margin-top: calc(10 * var(--u));
    }

    .paragraphs p + p {
      margin-top: calc(15 * var(--u));
    }

    .media {
      flex-flow: row wrap;
      align-items: flex-start;
      gap: calc(50 * var(--u));
    }

    .project-link {
      gap: calc(8 * var(--u));
    }

    .project-link a {
      font-size: calc(19 * var(--u));
    }

    .project-link.with-qr {
      width: calc(224 * var(--u));
    }
  }
</style>
