---
import Base from '../../layouts/Base.astro';
---

<Base title="Irina — UX/UI designer" description="The English version of this portfolio is coming soon.">
  <section class="stub container">
    <h1 class="h1">Coming soon</h1>
    <p class="text-2">The English version of this page will be available soon.</p>
    <a class="back button-2" href="/">Back to the Russian version</a>
  </section>
</Base>

<style>
  .stub {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding-top: 36px;
    padding-bottom: 36px;
  }

  .stub p {
    color: var(--color-gray);
  }

  .back {
    padding: 10px 20px;
    border-radius: var(--radius-sm);
    background: var(--color-black);
    color: var(--color-white);
  }
</style>
