---
import Base from '../layouts/Base.astro';
import Contacts from '../sections/Contacts.astro';
import Intro from '../sections/Intro.astro';
import Projects from '../sections/Projects.astro';
import Skills from '../sections/Skills.astro';
import Testimonials from '../sections/Testimonials.astro';
---

<Base title="Ирина — UX/UI дизайнер" description="Портфолио UX/UI дизайнера: игры, мобильные приложения и SaaS.">
  <div class="page">
    <Intro />
    <Skills />
    <Projects />
    <Testimonials />
    <Contacts />
  </div>
</Base>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 100px;
    padding-block: 36px;
  }
</style>
