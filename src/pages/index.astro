---
import Base from '../layouts/Base.astro';
import { navItems } from '../data/nav';
---

<Base title="Ирина — UX/UI дизайнер" description="Портфолио UX/UI дизайнера: игры, мобильные приложения и SaaS.">
  {/* Temporary placeholders so the menu anchors can be checked; replaced by real sections in stage 2. */}
  {
    navItems.map((item) => (
      <section class="placeholder container" id={item.id}>
        <h2 class="h1">{item.label}</h2>
      </section>
    ))
  }
</Base>

<style>
  .placeholder {
    min-height: 80vh;
    padding-top: 36px;
  }
</style>
