---
interface Props {
  tags: string;
  about: string;
}

const { tags, about } = Astro.props;
---

<dl class="project-meta">
  <div class="row">
    <dt class="button-2 trim">Теги</dt>
    <dd class="text-1 trim">{tags}</dd>
  </div>
  <div class="row">
    <dt class="button-2 trim">О проекте</dt>
    <dd class="text-1 trim">{about}</dd>
  </div>
</dl>

<style>
  .project-meta {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 16px;
    border-radius: var(--radius-sm);
    background: var(--color-violet);
    overflow-wrap: anywhere;
  }

  .row {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }

  .row + .row {
    gap: 10px;
  }

  dt {
    flex-shrink: 0;
    color: var(--color-white);
    white-space: nowrap;
  }

  dd {
    flex: 1;
    min-width: 0;
    color: rgb(255 255 255 / 0.6);
  }

  @media (min-width: 1024px) {
    .project-meta {
      flex-shrink: 0;
      width: calc(513 * var(--u));
      padding: calc(25 * var(--u));
      border-radius: calc(20 * var(--u));
    }

    .row,
    .row + .row {
      gap: calc(10 * var(--u));
    }

    /* Desktop/Headline 6 */
    dt {
      font: 600 calc(19 * var(--u)) / 1.2 var(--font-text);
      letter-spacing: -0.03em;
    }

    /* Desktop/Text 3 */
    dd {
      font-size: calc(20 * var(--u));
      line-height: calc(24 * var(--u));
      letter-spacing: -0.03em;
    }
  }
</style>
