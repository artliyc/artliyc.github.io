---
import { Image } from 'astro:assets';
import type { Contact } from '../data/contacts';

interface Props {
  contact: Contact;
}

const { contact } = Astro.props;
const external = contact.href.startsWith('http');
---

<a
  class:list={['contact-card', { 'with-qr': contact.qr }]}
  href={contact.href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
>
  <span class="h3 trim">
    {
      contact.title.map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))
    }
  </span>
  {contact.value && <span class="text-4 trim">{contact.value}</span>}
  {
    contact.qr && (
      <span class="qr" style={`--qr-width: ${contact.qr.desktopWidth ?? 214}`}>
        <Image src={contact.qr.src} alt="QR-код" width={585} quality={92} style={`object-fit: ${contact.qr.fit}`} />
      </span>
    )
  }
</a>

<style>
  .contact-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 25px;
    padding: 30px 30px 20px;
    border-radius: var(--radius-md);
    background: var(--color-violet);
    color: var(--color-white);
  }

  .contact-card span {
    display: block;
  }

  /* Hover: the card turns black, the colour of the other dark controls. */
  .contact-card {
    transition: background-color 0.3s ease;
  }

  @media (hover: hover) {
    .contact-card:hover {
      background: var(--color-black);
    }
  }

  .with-qr {
    gap: 10px;
    height: 260px;
    padding-bottom: 30px;
  }

  .qr {
    position: relative;
    width: 195px;
    aspect-ratio: 195 / 165;
  }

  .qr img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-position: bottom;
    mix-blend-mode: screen;
  }

  @media (min-width: 1024px) {
    .contact-card {
      position: relative;
      gap: calc(25 * var(--u));
      width: 100%;
      height: auto;
      padding: calc(30 * var(--u)) calc(30 * var(--u)) calc(20 * var(--u));
      border-radius: calc(20 * var(--u));
    }

    .with-qr {
      padding-bottom: calc(20 * var(--u));
    }

    /* Desktop/Headline 5 */
    .contact-card .h3 {
      font: 600 calc(38 * var(--u)) / 1 var(--font-heading);
      letter-spacing: -0.01em;
    }

    /* Desktop/Text 1 */
    .contact-card .text-4 {
      font-size: calc(28 * var(--u));
      line-height: calc(36 * var(--u));
    }

    .qr {
      position: absolute;
      /* 214px tall, centred on the card (350px wide). */
      top: calc(89 * var(--u));
      left: calc((350 - var(--qr-width)) / 2 * var(--u));
      width: calc(var(--qr-width) * var(--u));
      height: calc(214 * var(--u));
      aspect-ratio: auto;
    }
  }
</style>
