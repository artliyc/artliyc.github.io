---
import { Image } from 'astro:assets';
import type { GalleryItem } from '../data/projects/types';

interface Props {
  /** One gallery group: captioned items separated by 16px. */
  items: GalleryItem[];
}

const { items } = Astro.props;
---

<div class="gallery">
  {
    items.map((item) => (
      <figure class:list={['item', item.layout]}>
        {item.caption && <figcaption class="h6 trim">{item.caption}</figcaption>}
        <div class="images">
          {item.images.map((image) => (
            <Image
              src={image.src}
              alt=""
              width={image.width * 2}
              widths={[image.width * 2, image.width * 3]}
              sizes={`${image.width}px`}
              quality={92}
              style={`max-width: ${image.width}px; aspect-ratio: ${image.width} / ${image.height}; object-fit: ${image.fit ?? 'cover'}`}
            />
          ))}
        </div>
      </figure>
    ))
  }
</div>

<style>
  .gallery,
  .item,
  .images {
    display: flex;
    flex-direction: column;
  }

  .gallery {
    gap: 16px;
  }

  .item {
    gap: 8px;
  }

  .item.list {
    gap: 16px;
  }

  figcaption {
    color: var(--color-gray);
  }

  .list .images {
    gap: 25px;
  }

  .grid .images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 179px));
    gap: 16px 10px;
  }

  .images img {
    width: 100%;
    height: auto;
  }
</style>
