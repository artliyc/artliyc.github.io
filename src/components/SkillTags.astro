---
// Black skill tags laid out two per row, as in the mockup.
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const rows: string[][] = [];
for (let i = 0; i < tags.length; i += 2) rows.push(tags.slice(i, i + 2));
---

<ul class="skill-tags">
  {
    rows.map((row) => (
      <li>
        <ul class="row">
          {row.map((tag) => (
            <li class="tag button-2">
              <span class="trim">{tag}</span>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<style>
  .skill-tags,
  .row {
    display: flex;
    gap: 14px;
  }

  .skill-tags {
    flex-direction: column;
  }

  .tag {
    display: flex;
    align-items: center;
    height: 48px;
    padding-inline: 20px;
    border-radius: var(--radius-sm);
    background: var(--color-black);
    color: var(--color-white);
    white-space: nowrap;
  }

  /* Desktop: all tags in one row. */
  @media (min-width: 1024px) {
    .skill-tags {
      flex-flow: row wrap;
      gap: calc(20 * var(--u));
    }

    .skill-tags > li,
    .row {
      display: contents;
    }

    .tag {
      height: calc(60 * var(--u));
      padding-inline: calc(20 * var(--u));
      border-radius: calc(20 * var(--u));
      font: 400 calc(24 * var(--u)) / calc(32 * var(--u)) var(--font-text);
      letter-spacing: -0.03em;
    }
  }
</style>
