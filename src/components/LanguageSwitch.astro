---
import { languages } from '../data/nav';

const current = Astro.currentLocale ?? 'ru';
---

<div class="language-switch">
  {
    languages.map((language) => (
      <a
        class="option button-1"
        href={language.href}
        hreflang={language.locale}
        aria-current={language.locale === current ? 'true' : undefined}
      >
        <span class="trim">{language.label}</span>
      </a>
    ))
  }
</div>

<style>
  .language-switch {
    display: flex;
    gap: 9px;
  }

  .option {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: 1px solid var(--color-black);
    border-radius: var(--radius-md);
    background: var(--color-black);
    color: var(--color-yellow);
  }

  .option[aria-current] {
    background: none;
    color: var(--color-black);
  }

  /* Desktop: one pill split in two halves. */
  @media (min-width: 1024px) {
    .language-switch {
      gap: 0;
    }

    .option {
      width: calc(92 * var(--u));
      height: calc(84 * var(--u));
      border-radius: 0;
      font-size: calc(26 * var(--u));
      letter-spacing: -0.03em;
    }

    .option:first-child {
      border-radius: calc(60 * var(--u)) 0 0 calc(60 * var(--u));
    }

    .option:last-child {
      border-radius: 0 calc(60 * var(--u)) calc(60 * var(--u)) 0;
    }
  }
</style>
