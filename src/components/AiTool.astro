---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  icon: ImageMetadata;
}

const { name, icon } = Astro.props;
---

<li class="ai-tool">
  <div class="tile">
    <Image src={icon} alt="" width={174} quality={92} />
  </div>
  <p class="text-1 trim">{name}</p>
</li>

<style>
  .ai-tool {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 112px;
    text-align: center;
  }

  /* Icon offsets are taken from the Figma tile; it is not exactly centred there. */
  .tile {
    width: 112px;
    height: 112px;
    padding: 27.63px 0 0 29.12px;
    border-radius: 22.4px;
    background: var(--color-black);
  }

  .tile img {
    width: 57.49px;
    height: 57.49px;
    object-fit: cover;
  }
</style>
