---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  icon: ImageMetadata;
}

const { name, icon } = Astro.props;
---

<li class="ai-tool">
  <div class="tile">
    <Image src={icon} alt="" width={174} quality={92} />
  </div>
  <p class="text-1 trim">{name}</p>
</li>

<style>
  .ai-tool {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 112px;
    text-align: center;
  }

  /* Icon offsets are taken from the Figma tile; it is not exactly centred there. */
  .tile {
    width: 112px;
    height: 112px;
    padding: 27.63px 0 0 29.12px;
    border-radius: 22.4px;
    background: var(--color-black);
  }

  .tile img {
    width: 57.49px;
    height: 57.49px;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .ai-tool {
      gap: calc(12 * var(--u));
      width: calc(112 * var(--u));
    }

    .tile {
      width: calc(112 * var(--u));
      height: calc(112 * var(--u));
      padding: calc(27.63 * var(--u)) 0 0 calc(29.12 * var(--u));
      border-radius: calc(22.4 * var(--u));
    }

    .tile img {
      width: calc(57.49 * var(--u));
      height: calc(57.49 * var(--u));
    }

    .ai-tool p {
      font-size: calc(24 * var(--u));
      line-height: calc(32 * var(--u));
      letter-spacing: -0.03em;
    }
  }
</style>
