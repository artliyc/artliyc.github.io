---
import quote from '../assets/icons/quote.svg';
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonial: Testimonial;
}

const { testimonial } = Astro.props;
---

<figure class="testimonial-card">
  <figcaption class="author">
    <span class="quote-icon">
      <img src={quote.src} alt="" width="39" height="33" />
    </span>
    <div class="info">
      <p class="h4">{testimonial.name}</p>
      <div class="details text-2">
        <p class="trim">{testimonial.role}</p>
        <p class="trim">{testimonial.company}</p>
      </div>
    </div>
  </figcaption>
  <blockquote class="text text-1 trim">
    {testimonial.text.map((paragraph) => <p>{paragraph}</p>)}
  </blockquote>
</figure>

<style>
  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 16px;
    border-radius: var(--radius-md);
    background: var(--color-light-gray);
  }

  .author {
    display: flex;
    gap: 10px;
  }

  .quote-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 67px;
    height: 61px;
    border-radius: var(--radius-sm);
    background: var(--color-violet);
  }

  .quote-icon img {
    width: 39.19px;
    height: 33.23px;
  }

  .info {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .details {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--color-gray);
  }

  .text p + p {
    margin-top: 15px;
  }

  /* Desktop: author on the left, quote in two columns on the right. */
  @media (min-width: 1024px) {
    .testimonial-card {
      flex-direction: row;
      align-items: flex-start;
      gap: calc(70 * var(--u));
      padding: calc(30 * var(--u));
      border-radius: calc(20 * var(--u));
    }

    .author {
      flex-shrink: 0;
      gap: calc(30 * var(--u));
    }

    .quote-icon {
      width: calc(126.54 * var(--u));
      height: calc(116 * var(--u));
      border-radius: calc(30 * var(--u));
    }

    .quote-icon img {
      width: calc(71 * var(--u));
      height: calc(60.5 * var(--u));
    }

    .info {
      gap: calc(15 * var(--u));
      width: calc(307 * var(--u));
    }

    /* Desktop/Headline 5 */
    .info .h4 {
      font: 600 calc(38 * var(--u)) / 1 var(--font-heading);
      letter-spacing: -0.01em;
      white-space: nowrap;
      text-box: trim-both cap alphabetic;
    }

    /* Desktop/Button/Text 2 */
    .details {
      gap: calc(12 * var(--u));
      font: 600 calc(26 * var(--u)) / 1.3 var(--font-heading);
      letter-spacing: -0.03em;
    }

    /* Desktop/Text 2 */
    .text {
      flex: 1;
      columns: 2;
      column-gap: calc(50 * var(--u));
      font-size: calc(24 * var(--u));
      line-height: calc(32 * var(--u));
      letter-spacing: -0.03em;
    }

    .text p {
      break-inside: avoid;
    }

    .text p + p {
      margin-top: calc(15 * var(--u));
    }
  }
</style>
