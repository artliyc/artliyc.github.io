---
// Desktop social link: black pill with a label and an arrow.
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a class="social-pill" href={href} target="_blank" rel="noopener noreferrer">
  <span class="label trim"><slot /></span>
  <span class="arrow"></span>
</a>

<style>
  .social-pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: calc(282 * var(--u));
    height: calc(80 * var(--u));
    padding: 0 calc(10 * var(--u)) 0 calc(35 * var(--u));
    border-radius: calc(60 * var(--u));
    background: var(--color-black);
    color: var(--color-white);
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .label {
    font: 600 calc(36 * var(--u)) / 1.3 var(--font-heading);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .arrow {
    position: relative;
    flex-shrink: 0;
    width: calc(60 * var(--u));
    height: calc(60 * var(--u));
    background: url('../assets/icons/arrow.svg') center / 100% 100% no-repeat;
  }

  /* Hover/pressed icon sits on top and fades in, so the swap is not abrupt. */
  .arrow::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('../assets/icons/arrow-hover.svg') center / 100% 100% no-repeat;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) {
    .social-pill:hover {
      background: var(--color-yellow);
      color: var(--color-black);
    }

    .social-pill:hover .arrow::after {
      opacity: 1;
    }
  }

  .social-pill:active {
    background: var(--color-white);
    color: var(--color-black);
  }

  .social-pill:active .arrow::after {
    background-image: url('../assets/icons/arrow-pressed.svg');
    opacity: 1;
  }
</style>
