---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { crop } = project;
const cropStyle = crop
  ? `top: ${crop.top}%; left: ${crop.left}%; width: ${crop.width}%; height: ${crop.height}%`
  : undefined;
// Rendered width of the image in px at the 402px frame (the slot is 330px wide).
const displayWidth = Math.round((330 * (crop?.width ?? 100)) / 100);
---

<a class="project-card" href={`/projects/${project.slug}/`}>
  <div class:list={['thumbnail', { cropped: crop }]}>
    <Image
      src={project.thumbnail}
      alt=""
      width={displayWidth * 2}
      widths={[displayWidth * 2, displayWidth * 3]}
      sizes={`${displayWidth}px`}
      quality={92}
      style={cropStyle}
    />
  </div>
  <div class="text">
    <h3 class="h4">{project.title}</h3>
    <div class="description text-1 trim">
      {project.description.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
  <ul class="tags">
    {
      project.tags.map((tag) => (
        <li class="tag button-2">
          <span class="trim">{tag}</span>
        </li>
      ))
    }
  </ul>
</a>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
    border-radius: var(--radius-md);
    background: var(--color-light-gray);
  }

  .thumbnail {
    position: relative;
    aspect-ratio: 330 / 260;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: var(--color-dark-gray);
  }

  .thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .thumbnail.cropped img {
    position: absolute;
    max-width: none;
    object-fit: fill;
  }

  .text {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .description {
    color: var(--color-gray);
  }

  .description p + p {
    margin-top: 15px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    display: flex;
    align-items: center;
    height: 28px;
    padding-inline: 16px;
    border-radius: var(--radius-sm);
    background: var(--color-violet);
    color: var(--color-white);
    white-space: nowrap;
  }

  /* Desktop: thumbnail and text side by side, tags pinned to the bottom. */
  @media (min-width: 1024px) {
    .project-card {
      display: grid;
      grid-template-columns: repeat(2, calc(372 * var(--u)));
      grid-template-rows: 1fr auto;
      justify-content: space-between;
      gap: calc(20 * var(--u));
      width: 100%;
      min-height: calc(450 * var(--u));
      padding: calc(20 * var(--u));
      border-radius: calc(20 * var(--u));
    }

    .thumbnail {
      align-self: start;
      aspect-ratio: 372 / 293;
      border-radius: calc(10 * var(--u));
    }

    .text {
      gap: calc(20 * var(--u));
    }

    /* Desktop/Headline 5 */
    .text h3 {
      font: 600 calc(38 * var(--u)) / 1 var(--font-heading);
      letter-spacing: -0.01em;
      text-box: trim-both cap alphabetic;
    }

    /* Desktop/Text 3 */
    .description {
      font-size: calc(20 * var(--u));
      line-height: calc(24 * var(--u));
      letter-spacing: -0.03em;
    }

    .description p + p {
      margin-top: calc(10 * var(--u));
    }

    .tags {
      grid-column: 1 / -1;
      gap: calc(8 * var(--u));
    }

    /* Desktop/Tag 1 */
    .tag {
      height: auto;
      padding: calc(4 * var(--u)) calc(16 * var(--u));
      border-radius: calc(10 * var(--u));
      font: 500 calc(20 * var(--u)) / 1.3 var(--font-text);
    }

    .tag .trim {
      text-box: normal;
    }
  }
</style>
