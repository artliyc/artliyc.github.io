---
interface Props {
  variant?: 'yellow' | 'violet';
}

const { variant = 'yellow' } = Astro.props;
---

<h3 class:list={['section-heading', variant]}>
  <span class="h3 trim"><slot /></span>
</h3>

<style>
  .section-heading {
    display: flex;
    align-items: center;
    height: 50px;
    padding-left: 16px;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  .yellow {
    background: var(--color-yellow);
    color: var(--color-gray);
  }

  .violet {
    background: var(--color-violet);
    color: var(--color-white);
  }

  @media (min-width: 1024px) {
    .section-heading {
      height: auto;
    }

    /* On desktop the yellow chip becomes a plain grey heading (Headline 4). */
    .yellow {
      padding: 0;
      background: none;
    }

    .yellow .h3 {
      font: 700 calc(50 * var(--u)) / 0.9 var(--font-heading);
    }

    .violet {
      padding: calc(20 * var(--u));
      border-radius: calc(20 * var(--u));
    }

    .violet .h3 {
      font: 600 calc(38 * var(--u)) / 1 var(--font-heading);
      letter-spacing: -0.01em;
    }
  }
</style>
